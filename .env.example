NEXT_PUBLIC_API_URL=http://localhost:8000

# Listen port for PM2. Nginx upstream must match. NODE_ENV is loaded into the Next process.
HOST_FORWARD_APP_PORT=3000
NODE_ENV=production

# SEO & site identity (set in production)
NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_SITE_NAME=Next.js Boilerplate
NEXT_PUBLIC_SITE_DESCRIPTION=Production-ready Next.js starter with Ant Design and TanStack Query.
NEXT_PUBLIC_SITE_LOCALE=en_US
NEXT_PUBLIC_SITE_LANGUAGE=en
